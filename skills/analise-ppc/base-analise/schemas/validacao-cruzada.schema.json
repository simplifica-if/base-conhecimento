{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplifica-if.local/analise-ppc/validacao-cruzada.schema.json",
  "title": "Validação cruzada PPC",
  "type": "object",
  "required": [
    "id",
    "titulo",
    "dominio",
    "criticidade",
    "tipo",
    "secoes_relacionadas",
    "pergunta",
    "rubrica",
    "boa_evidencia",
    "ma_evidencia",
    "evidencia_minima",
    "estados_permitidos"
  ],
  "properties": {
    "id": { "type": "string" },
    "titulo": { "type": "string" },
    "dominio": { "type": "string", "enum": ["validacao_cruzada"] },
    "criticidade": { "type": "string", "enum": ["BLOQ", "OBRIG", "REC"] },
    "tipo": { "type": "string" },
    "secoes_relacionadas": { "type": "array", "items": { "type": "string" } },
    "condicionais_relacionadas": { "type": "array", "items": { "type": "string" } },
    "pergunta": { "type": "string" },
    "rubrica": { "type": "string" },
    "boa_evidencia": { "type": "string" },
    "ma_evidencia": { "type": "string" },
    "evidencia_minima": { "type": "integer", "minimum": 1 },
    "estados_permitidos": {
      "type": "array",
      "items": { "type": "string", "enum": ["ATENDE", "NAO_ATENDE", "INCONCLUSIVO", "NAO_APLICAVEL"] }
    }
  }
}
