{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/simplifica-if/base-conhecimento/main/schemas/campus.schema.json",
  "title": "Campus do IFPR",
  "type": "object",
  "required": [
    "id",
    "nome",
    "tipo_unidade",
    "links",
    "cursos",
    "curadoria"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nome": {
      "type": "string",
      "minLength": 1
    },
    "tipo_unidade": {
      "enum": [
        "campus",
        "campus_avancado"
      ]
    },
    "links": {
      "type": "object",
      "required": [
        "site",
        "calendario_academico"
      ],
      "additionalProperties": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "properties": {
        "site": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "calendario_academico": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "cursos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "nome",
          "nivel",
          "tipo_oferta",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "nome": {
            "type": "string",
            "minLength": 1
          },
          "nivel": {
            "enum": [
              "fundamental",
              "médio",
              "superior",
              "pós-graduação",
              "formação inicial e continuada"
            ]
          },
          "tipo_oferta": {
            "enum": [
              "técnico integrado",
              "técnico subsequente",
              "graduação tecnológica",
              "bacharelado",
              "licenciatura",
              "especialização",
              "mestrado",
              "FIC",
              "programa institucional"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      }
    },
    "curadoria": {
      "type": "object",
      "required": [
        "status_cursos",
        "verificado_em"
      ],
      "additionalProperties": false,
      "properties": {
        "status_cursos": {
          "enum": [
            "dados_pendentes",
            "dados_parciais",
            "dados_curados"
          ]
        },
        "fontes": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "verificado_em": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
