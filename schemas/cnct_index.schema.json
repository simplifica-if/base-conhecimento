{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/simplifica-if/base-conhecimento/main/schemas/cnct_index.schema.json",
  "title": "Índice de cursos CNCT",
  "type": "object",
  "required": [
    "id",
    "title",
    "descricao",
    "tipo_item",
    "schema_version",
    "atualizado_em",
    "total_cursos",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "const": "cnct-cursos"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "descricao": {
      "type": "string",
      "minLength": 1
    },
    "tipo_item": {
      "const": "curso_tecnico_cnct"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "atualizado_em": {
      "type": "string",
      "format": "date"
    },
    "total_cursos": {
      "type": "integer",
      "minimum": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "denominacao",
          "denominacao_normalizada",
          "eixo_tecnologico",
          "area_tecnologica",
          "carga_horaria_minima_horas",
          "codigos_cbo",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "denominacao": {
            "type": "string",
            "minLength": 1
          },
          "denominacao_normalizada": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?: [a-z0-9]+)*$"
          },
          "eixo_tecnologico": {
            "type": "string",
            "minLength": 1
          },
          "area_tecnologica": {
            "type": "string",
            "minLength": 1
          },
          "carga_horaria_minima_horas": {
            "type": "integer",
            "minimum": 1
          },
          "codigos_cbo": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d{4}(?:-\\d{2})?$"
            }
          },
          "path": {
            "type": "string",
            "pattern": "^catalogos/cnct/cursos/[a-z0-9]+(?:-[a-z0-9]+)*\\.json$"
          }
        }
      }
    }
  }
}
