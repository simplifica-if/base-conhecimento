{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/simplifica-if/base-conhecimento/main/schemas/campi_index.schema.json",
  "title": "Índice de campi do IFPR",
  "type": "object",
  "required": [
    "id",
    "title",
    "descricao",
    "tipo_item",
    "atualizado_em",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "const": "campi-ifpr"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "descricao": {
      "type": "string",
      "minLength": 1
    },
    "tipo_item": {
      "const": "campus"
    },
    "atualizado_em": {
      "type": "string",
      "format": "date"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "nome",
          "tipo_unidade",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "nome": {
            "type": "string",
            "minLength": 1
          },
          "tipo_unidade": {
            "enum": [
              "campus",
              "campus_avancado"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^institucional/ifpr/campi/[a-z0-9]+(?:-[a-z0-9]+)*\\.json$"
          }
        }
      }
    }
  }
}
