{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/simplifica-if/base-conhecimento/main/schemas/processos_seletivos_index.schema.json",
  "title": "Índice de processos seletivos do IFPR",
  "type": "object",
  "required": [
    "title",
    "total_itens",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "total_itens": {
      "type": "integer",
      "minimum": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "ano_ingresso",
          "nome",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "ano_ingresso": {
            "type": "integer",
            "minimum": 1900
          },
          "nome": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^institucional/ifpr/processos-seletivos/[a-z0-9]+(?:-[a-z0-9]+)*\\.json$"
          }
        }
      }
    }
  }
}
