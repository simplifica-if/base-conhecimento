{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/simplifica-if/base-conhecimento/main/schemas/institucional_manifest.schema.json",
  "title": "Manifesto institucional",
  "type": "object",
  "required": [
    "title",
    "tipo",
    "versao",
    "atualizado_em",
    "colecoes"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "tipo": {
      "const": "cadastro_institucional"
    },
    "versao": {
      "type": "integer",
      "minimum": 1
    },
    "atualizado_em": {
      "type": "string",
      "format": "date"
    },
    "colecoes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "tipo_item",
          "path",
          "total_itens"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "tipo_item": {
            "enum": [
              "campus",
              "processo_seletivo",
              "referencia_institucional"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^institucional/ifpr/(campi|processos-seletivos|referencias)/index\\.json$"
          },
          "total_itens": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
