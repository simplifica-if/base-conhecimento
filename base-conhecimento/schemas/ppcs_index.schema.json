{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/simplifica-if/base-conhecimento/main/schemas/ppcs_index.schema.json",
  "title": "Índice de PPCs do IFPR",
  "type": "object",
  "required": [
    "title",
    "tipo",
    "versao",
    "atualizado_em",
    "total_itens",
    "secoes",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "tipo": {
      "const": "indice_ppcs"
    },
    "versao": {
      "type": "integer",
      "minimum": 1
    },
    "atualizado_em": {
      "type": "string",
      "format": "date"
    },
    "total_itens": {
      "type": "integer",
      "minimum": 1
    },
    "secoes": {
      "type": "object",
      "required": [
        "preview_limite",
        "paths"
      ],
      "additionalProperties": false,
      "properties": {
        "preview_limite": {
          "const": 500
        },
        "paths": {
          "type": "object",
          "required": [
            "avaliacao",
            "concepcao_pedagogica",
            "corpo_docente",
            "ementas",
            "estagio_praticas",
            "identificacao",
            "infraestrutura",
            "justificativa",
            "matriz_curricular",
            "objetivos",
            "organizacao_curricular",
            "perfil_egresso",
            "referencias"
          ],
          "additionalProperties": false,
          "properties": {
            "avaliacao": {
              "const": "institucional/ifpr/ppcs/secoes/avaliacao.jsonl"
            },
            "concepcao_pedagogica": {
              "const": "institucional/ifpr/ppcs/secoes/concepcao_pedagogica.jsonl"
            },
            "corpo_docente": {
              "const": "institucional/ifpr/ppcs/secoes/corpo_docente.jsonl"
            },
            "ementas": {
              "const": "institucional/ifpr/ppcs/secoes/ementas.jsonl"
            },
            "estagio_praticas": {
              "const": "institucional/ifpr/ppcs/secoes/estagio_praticas.jsonl"
            },
            "identificacao": {
              "const": "institucional/ifpr/ppcs/secoes/identificacao.jsonl"
            },
            "infraestrutura": {
              "const": "institucional/ifpr/ppcs/secoes/infraestrutura.jsonl"
            },
            "justificativa": {
              "const": "institucional/ifpr/ppcs/secoes/justificativa.jsonl"
            },
            "matriz_curricular": {
              "const": "institucional/ifpr/ppcs/secoes/matriz_curricular.jsonl"
            },
            "objetivos": {
              "const": "institucional/ifpr/ppcs/secoes/objetivos.jsonl"
            },
            "organizacao_curricular": {
              "const": "institucional/ifpr/ppcs/secoes/organizacao_curricular.jsonl"
            },
            "perfil_egresso": {
              "const": "institucional/ifpr/ppcs/secoes/perfil_egresso.jsonl"
            },
            "referencias": {
              "const": "institucional/ifpr/ppcs/secoes/referencias.jsonl"
            }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "campus_id",
          "campus_nome",
          "curso_slug",
          "curso_nome",
          "nivel",
          "tipo_oferta",
          "curso_url",
          "fonte_pdf",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "campus_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "campus_nome": {
            "type": "string",
            "minLength": 1
          },
          "curso_slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "curso_nome": {
            "type": "string",
            "minLength": 1
          },
          "nivel": {
            "type": "string",
            "minLength": 1
          },
          "tipo_oferta": {
            "type": "string",
            "minLength": 1
          },
          "modalidade": {
            "type": "string",
            "minLength": 1
          },
          "situacao": {
            "type": "string",
            "minLength": 1
          },
          "ano_documento": {
            "type": "integer",
            "minimum": 1900
          },
          "vagas": {
            "type": "integer",
            "minimum": 0
          },
          "curso_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "fonte_pdf": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "path": {
            "type": "string",
            "pattern": "^institucional/ifpr/ppcs/[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"
          }
        }
      }
    }
  }
}
